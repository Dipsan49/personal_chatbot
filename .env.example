# Create an API key at https://ollama.com/settings/keys.
OLLAMA_API_KEY=replace_with_your_ollama_api_key
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_CHAT_MODEL=gpt-oss:20b
# Leave blank to use the built-in lexical and intent-aware resume retrieval.
OLLAMA_EMBEDDING_MODEL=
# On a host such as Render, paste the private Markdown into RESUME_CONTENT.
RESUME_CONTENT=
# Alternatively, point to a private file. Local development uses knowledge/resume.md.
RESUME_PATH=
PORT=3000
